{
  "name": "reqon",
  "private": true,
  "workspaces": [
    "packages/*",
    "docusaurus"
  ],
  "scripts": {
    "build": "npm run build --workspace reqon-dsl --",
    "dev": "npm run dev --workspace reqon-dsl --",
    "typecheck": "npm run typecheck --workspace reqon-dsl --",
    "test": "npm run test --workspace reqon-dsl --",
    "test:run": "npm run test:run --workspace reqon-dsl --",
    "test:coverage": "npm run test:coverage --workspace reqon-dsl --",
    "test:integration": "npm run test:integration --workspace reqon-dsl --",
    "test:crash": "npm run test:crash --workspace reqon-dsl --",
    "test:pg": "npm run test:pg --workspace reqon-dsl --",
    "check:docs": "npm run check:docs --workspace reqon-dsl --",
    "check:examples": "npm run check:examples --workspace reqon-dsl --",
    "check:snippets": "npm run check:snippets --workspace reqon-dsl --",
    "lint": "npm run lint --workspace reqon-dsl --",
    "lint:fix": "npm run lint:fix --workspace reqon-dsl --",
    "format": "npm run format --workspace reqon-dsl --",
    "format:check": "npm run format:check --workspace reqon-dsl --",
    "bench": "npm run bench --workspace reqon-dsl --",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/reqon-dsl/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "2.1.2"
    }
  }
}
