// Mock data definitions for E-Commerce API demo
// Imports schemas from OpenAPI spec and creates datasets for the mock server
//
// Run: npx vague examples/mock-server-demo/mock-data.vague --serve 4000

import ecommerce from "examples/mock-server-demo/openapi.yaml"

schema Product {
  id: string,
  name: string,
  price: decimal,
  category: string,
  inStock: boolean,
  stockQuantity: int
}

schema Order {
  id: string,
  orderNumber: string,
  status: string,
  total: decimal,
  createdAt: date,
  itemCount: int
}

schema InventoryItem {
  productId: string,
  sku: string,
  quantity: int,
  warehouseLocation: string
}
