// Cross-Reference and Validate
//
// These checks cross-reference records that DO exist across stores, using a
// nested `for ... in <store> where ...` join. (Detecting the *absence* of a
// matching record — e.g. an order with no payment at all — needs an anti-join
// the DSL can't express inline today, so those checks are omitted rather than
// written in a way that silently flags every order.)

action ValidateReconciliation {
  // Check for payment/order amount mismatches. `validate ... or { ... }` asserts
  // the amounts agree and, on failure, runs the fallback block instead of
  // aborting the mission — here recording a discrepancy and carrying on.
  for order in orders {
    for payment in payments where .order_id == order.order_id {
      validate payment {
        assume .amount >= order.total_amount - 0.01
        assume .amount <= order.total_amount + 0.01
      } or {
        store {
          id: "disc_" + order.order_id + "_amount_mismatch",
          order_id: order.order_id,
          type: "amount_mismatch",
          severity: match true {
            abs(order.total_amount - payment.amount) > 100 => "critical",
            abs(order.total_amount - payment.amount) > 10 => "high",
            _ => "medium"
          },
          description: "Order total does not match payment total",
          shopify_value: order.total_amount,
          stripe_value: payment.amount,
          shipstation_value: null,
          detected_at: now()
        } -> discrepancies { key: .id, upsert: true }
      }
    }
  },

  // Check for refund discrepancies
  for payment in payments where .refunded_amount > 0 {
    for order in orders where .order_id == payment.order_id {
      match order {
        _ where order.payment_status != "refunded" and order.payment_status != "partial_refund" -> {
          store {
            id: "disc_" + payment.order_id + "_refund_mismatch",
            order_id: payment.order_id,
            type: "refund_status_mismatch",
            severity: "high",
            description: "Stripe shows refund but Shopify payment status not updated",
            shopify_value: order.payment_status,
            stripe_value: payment.refunded_amount,
            shipstation_value: null,
            detected_at: now()
          } -> discrepancies { key: .id, upsert: true }
        }
      }
    }
  }
}
