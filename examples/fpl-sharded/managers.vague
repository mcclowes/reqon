// FPL manager records - the fleet-ready, resumable pull.
//
// Fetches the first 100,000 manager records (/entry/{id}/) as fast as the egress
// allows. Same endpoint, schema, model and store tuning as first-500k.vague; the
// difference is that this file is built to scale out and survive a restart:
//   - proxy pool egress, so the rate fans across IPs (each with its own budget)
//   - checkpoint: onFailure, so a crash resumes instead of restarting from zero
//
// The ids come from range() here. To pull an *arbitrary* set instead - a fleet
// slice, a re-fetch of stale records - swap the range for a shard file (see the
// commented store + loop below); the rest is identical.

mission FplManagers {

  // Durable execution: on a failure the run persists its state so it can resume
  // rather than restart. Upserts are idempotent, so a resumed run reconciles
  // safely. onFailure (not afterStep) keeps the hot path fast - it doesn't
  // checkpoint every one of the 100k iterations, only when something breaks.
  checkpoint: onFailure

  source FPL {
    auth: none,
    base: "https://fantasy.premierleague.com/api",

    headers: {
      "User-Agent": env("FPL_USER_AGENT")
    },

    // Each entry is one egress IP, rotated round-robin per request attempt.
    // Rate limit and breaker state are keyed per proxy, so this worker gets four
    // independent budgets rather than four ways to burn one. Leave all four unset
    // and the mission runs direct from this host (the runnable default); setting
    // only some is an error, since a short pool concentrates the whole rate onto
    // whichever proxies resolved.
    proxy: [
      env("FPL_PROXY_1"),
      env("FPL_PROXY_2"),
      env("FPL_PROXY_3"),
      env("FPL_PROXY_4")
    ],

    // Modeled at FPL's measured single-IP ceiling (burst ~5,000-7,000, then
    // sustains ~1,800/s), keyed per proxy. safety 0.9 paces just under; a 429
    // (FPL sends no Retry-After) tightens the lane automatically, so the numbers
    // are a ceiling to aim at, not one to land exactly.
    rateLimit: {
      strategy: throttle,
      maxWait: 300,
      model: { type: tokenBucket, capacity: 5000, refill: 1800, safety: 0.9 }
    },

    // Tolerant breaker: at ~1,600 req/s a short 429 burst during calibration is
    // normal and mustn't trip the circuit. failureRate opens only on a sustained
    // bad patch. Per proxy, so one failing IP opens only its own circuit.
    circuitBreaker: {
      failureRate: 0.5,
      minimumRequests: 200,
      resetTimeout: 30,
      failureWindow: 30
    }
  }

  // One write, not 100,000. `batch` buffers the run in memory (relaxed = writes
  // never block the fan-out) and flushes once on close - the file store rewrites
  // the whole file per flush, so a per-record or small batch would be O(n^2) IO
  // and the store, not the fetch, would be the bottleneck. For a fleet writing
  // one shared table, swap in
  //   store managers: postgrest("fpl_managers") { batch: { size: 500, durability: relaxed } }
  // which flushes each 500-row batch as one array POST; shards are disjoint, so
  // there's no last-writer-wins race between workers.
  store managers: file("fpl_managers") {
    batch: { size: 200000, maxDelay: 3600000, durability: relaxed }
  }

  // Items that exhaust their retries land here instead of failing the run, so a
  // long pull finishes and the stragglers can be swept afterwards.
  store failures: file("fpl_manager_failures")

  // For an arbitrary id set instead of the first N, feed a shard file: the
  // orchestrator writes this worker's slice as { "12": { "id": 12 }, ... }, then
  //   store shard: file("fpl_shard")
  //   for entry in shard concurrency 192 onError queue failures {
  //     get "/entry/{entry.id}/" { ... }   // and map id: entry.id
  // Everything else is unchanged.

  // The manager record from /entry/{id}/: who they are and their standing.
  // (Overall points/rank are null out of season and populate once it starts.)
  schema Manager {
    id: number,
    name: string,
    firstName: string,
    lastName: string,
    region: string,
    startedEvent: number,
    overallPoints: number,
    overallRank: number
  }

  action FetchManagers {
    // The first 100,000 ids, generated in-mission - no shard file to write first.
    // /entry/{id}/ is a heavy payload (~100ms round-trip - it embeds the
    // manager's leagues), so it takes many in-flight requests to reach the
    // model's ~1,600 req/s pace: at low concurrency the socket count is the
    // limit, not the model. 192 fills the latency pipe for one IP; with the proxy
    // pool set, raise it toward pool-size x 192 to use every proxy's budget. The
    // model caps the rate regardless, so this can't run away.
    for id in range(1, 100001) concurrency 192 onError queue failures {

      get "/entry/{id}/" {
        source: FPL,
        // Low ids include managers that never existed; 404 is data, not a retry.
        allow: [404],
        retry: {
          maxAttempts: 5,
          backoff: exponential,
          initialDelay: 2000,
          maxDelay: 120000
        }
      }

      // A match written only on statuses falls through when none apply, so a 200
      // carries on to the map below without needing a `_` arm.
      match response {
        404 -> skip
      }

      // `id` comes from the loop variable rather than the payload, so the upsert
      // key is always the id we asked for.
      map response -> Manager {
        id: id,
        name: .name,
        firstName: .player_first_name,
        lastName: .player_last_name,
        region: .player_region_name,
        startedEvent: .started_event,
        overallPoints: .summary_overall_points,
        overallRank: .summary_overall_rank
      }

      store response -> managers {
        key: .id,
        upsert: true
      }
    }
  }

  run FetchManagers
}
