// FPL manager records - the sharded fan-out.
//
// Demonstrates: proxy pool egress, for-loop concurrency, shard-by-env.
//
// Same endpoint and schema as first-500k.vague; the difference is where the ids
// come from. There they're generated in-mission with range(); here each worker
// is handed an arbitrary slice, so a fleet can cover ids that aren't contiguous.
//
// One worker runs this file. The orchestrator (k8s Job, Fly Machines, a GitHub
// Actions matrix) starts N of them, each with its own shard file and its own
// slice of the proxy pool. Requests leave through the proxies, rate limit and
// circuit breaker state is tracked per egress IP, and every worker upserts into
// the same PostgREST table.

mission FplShardedManagers {

  source FPL {
    auth: none,
    base: "https://fantasy.premierleague.com/api",

    headers: {
      "User-Agent": env("FPL_USER_AGENT")
    },

    // Each entry is one egress IP, rotated round-robin per request attempt.
    // Rate limit and breaker state are keyed per proxy, so this worker gets
    // four independent budgets rather than four ways to burn one.
    //
    // Leave all four unset and the mission runs direct from this host, which is
    // how to try it without a proxy provider. Setting only some of them is an
    // error: a short pool concentrates the whole request rate onto whichever
    // proxies did resolve, which is the failure the pool exists to prevent.
    proxy: [
      env("FPL_PROXY_1"),
      env("FPL_PROXY_2"),
      env("FPL_PROXY_3"),
      env("FPL_PROXY_4")
    ],

    // FPL sends no rate-limit headers - its OpenResty limiter has no Retry-After
    // - so pacing is entirely the client's job, and a 429 is the only feedback
    // it gets. The `model` mirrors that limiter locally: `capacity` requests
    // burst through, then it settles to `refill`/second, keyed per proxy.
    //
    // The numbers are a *ceiling guess*, not a measured truth. On a 429 reqon
    // tightens the lane below the guess and holds there; when the 429s stop it
    // eases back up. So an imperfect guess self-corrects instead of melting down
    // - which is what makes a headerless limiter survivable. (A flat `fallbackRpm`
    // is the simpler alternative, but it can't learn from a 429.)
    //
    // These are deliberately conservative - burst 20, then ~5/s per proxy - so
    // the example stays polite from one host. FPL's true ceiling is far higher:
    // measured from one IP it absorbs a burst of ~5,000-7,000 then sustains
    // ~1,800/s before throttling in earnest. Raise capacity/refill toward that
    // for a real fleet; you don't have to land it exactly, since overshoot makes
    // the 429 feedback pull the pace back.
    rateLimit: {
      strategy: throttle,
      maxWait: 300,
      model: { type: tokenBucket, capacity: 20, refill: 5, safety: 0.9 }
    },

    // A proxy that starts failing drops out on its own rather than poisoning
    // the run. Only that proxy's circuit opens - the others keep working.
    circuitBreaker: {
      failureThreshold: 5,
      resetTimeout: 120,
      failureWindow: 60
    }
  }

  // The orchestrator writes this worker's slice of manager IDs before start,
  // as a JSON object keyed by id: { "12": { "id": 12 }, "97": { "id": 97 } }.
  // A contiguous block would be range(); the shard file is what lets a worker
  // take an arbitrary set - a resume list, a re-fetch of stale records.
  store shard: file("fpl_shard")

  // A file store keeps this runnable on one machine, one write per manager.
  // Plain is the right default here: a file store rewrites the whole file per
  // flush, so batching buys little, and a strict batch sized above the loop's
  // concurrency is actively *slower* (see below).
  store managers: file("fpl_managers")

  // For a real fleet, swap in a shared table and batch the writes:
  //   store managers: postgrest("fpl_managers") { batch: { size: 500, durability: relaxed } }
  // Every worker upserts into one table; shards are disjoint, so there's no
  // last-writer-wins race. There `batch` collapses 500 row-at-a-time round-trips
  // into one array POST - a real win over the network. But mind two things:
  //   - `durability: relaxed` lets each write resolve immediately, so the
  //     fan-out runs at full speed and the batch fills by size in the
  //     background. `strict` (the default) holds each write until its batch
  //     flushes; if the batch size exceeds the loop's concurrency it never fills
  //     by size and every flush waits on the 100ms timer - capping throughput at
  //     ~concurrency x 10/s. (Measured against a zero-latency mock at
  //     concurrency 8: strict batch-500 ~70 writes/s, relaxed ~16k/s.)
  //   - relaxed trades crash-safety of the in-flight buffer (up to `size`
  //     records) for that speed. This run is resumable and upserts are
  //     idempotent, so a lost slice is just re-fetched - a good trade here.

  // Items that exhaust their retries land here instead of failing the run, so a
  // long shard finishes and the stragglers can be swept afterwards.
  store failures: file("fpl_manager_failures")

  // The manager record from /entry/{id}/: who they are and their standing.
  // (Overall points/rank are null out of season and populate once it starts.)
  schema Manager {
    id: number,
    name: string,
    firstName: string,
    lastName: string,
    region: string,
    startedEvent: number,
    overallPoints: number,
    overallRank: number
  }

  action FetchManagers {
    // Eight iterations in flight. Roughly pool size x 2: enough to keep every
    // proxy busy while one is waiting on the wire, low enough that the
    // per-proxy throttle is what paces the run, not the socket count.
    for entry in shard concurrency 8 onError queue failures {

      get "/entry/{entry.id}/" {
        source: FPL,
        // A shard drawn from a stale id list will contain managers that no
        // longer exist. Allowing 404 returns it as data rather than retrying
        // it five times and burning the budget on a record that isn't coming.
        allow: [404],
        retry: {
          maxAttempts: 5,
          backoff: exponential,
          initialDelay: 2000,
          maxDelay: 120000
        }
      }

      // Dispatches on the status the `allow` above let through. A match written
      // only on statuses falls through when none apply, so a 200 carries on to
      // the map below without needing a `_` arm.
      match response {
        404 -> skip
      }

      // `id` comes from the loop variable rather than the payload, so the
      // upsert key is always the shard entry that produced the record.
      map response -> Manager {
        id: entry.id,
        name: .name,
        firstName: .player_first_name,
        lastName: .player_last_name,
        region: .player_region_name,
        startedEvent: .started_event,
        overallPoints: .summary_overall_points,
        overallRank: .summary_overall_rank
      }

      store response -> managers {
        key: .id,
        upsert: true
      }
    }
  }

  run FetchManagers
}
