// File Export Example
// Demonstrates: file() store type for exporting data to files
// Use case: Generating CSV/JSON exports, backup files, and report artifacts

mission DataExport {

  // ============================================================
  // SOURCES
  // ============================================================

  source SalesAPI {
    auth: api_key,
    base: "https://api.sales.example.com/v2"
  }

  source InventoryAPI {
    auth: bearer,
    base: "https://inventory.example.com/api"
  }

  // ============================================================
  // STORES
  // ============================================================

  // Memory stores for processing
  store orders: memory("orders")
  store products: memory("products")
  store customers: memory("customers")

  // File stores for exports
  store orders_export: file("exports/orders")
  store inventory_report: file("exports/inventory")
  store customer_export: file("exports/customers")
  store daily_summary: file("exports/daily-summary")
  store backup: file("backups/full-backup")

  // ============================================================
  // SCHEMAS
  // ============================================================

  schema Order {
    id: string,
    customer_id: string,
    items: array,
    total: decimal,
    status: string,
    created_at: date
  }

  schema Product {
    sku: string,
    name: string,
    price: decimal,
    quantity: int,
    category: string
  }

  schema Customer {
    id: string,
    name: string,
    email: string,
    total_orders: int,
    lifetime_value: decimal
  }

  schema ExportMetadata {
    export_type: string,
    record_count: int,
    generated_at: date,
    format: string
  }

  // ============================================================
  // ACTION: Fetch Data for Export
  // ============================================================

  action FetchData {
    // Fetch orders
    get "/orders" {
      source: SalesAPI,
      paginate: page(page, 100),
      until: response.orders.length == 0,
      since: lastSync
    }

    for order in response.orders {
      map order -> Order {
        id: .id,
        customer_id: .customer.id,
        items: .line_items,
        total: .total_amount,
        status: .status,
        created_at: .created_at
      }

      store response -> orders { key: .id }
    }

    // Fetch products
    get "/products" {
      source: InventoryAPI,
      paginate: cursor(cursor, 200, "pagination.next")
    }

    for product in response.products {
      map product -> Product {
        sku: .sku,
        name: .name,
        price: .price,
        quantity: .stock_level,
        category: .category.name
      }

      store response -> products { key: .sku }
    }
  }

  // ============================================================
  // ACTION: Export Orders to File
  // ============================================================

  action ExportOrders {
    // Export each order to file store
    for order in orders {
      // Flatten order for CSV-style export
      store {
        order_id: order.id,
        customer_id: order.customer_id,
        item_count: length(order.items),
        total: order.total,
        status: order.status,
        created_at: order.created_at,
        exported_at: now()
      } -> orders_export {
        key: order.id
      }
    }

    // Store export metadata
    store {
      export_type: "orders",
      record_count: length(orders),
      generated_at: now(),
      format: "json"
    } -> orders_export {
      key: "_metadata"
    }
  }

  // ============================================================
  // ACTION: Generate Inventory Report
  // ============================================================

  action GenerateInventoryReport {
    // Group products by category for reporting
    let categories = ["Electronics", "Clothing", "Home", "Sports", "Other"]

    for category in categories {
      // Iterate the products in this category directly with a filtered for loop
      // and emit a per-product row into the category's report bucket.
      for product in products where .category == category {
        store {
          category: category,
          sku: product.sku,
          name: product.name,
          line_value: product.price * product.quantity,
          low_stock: product.quantity < 10,
          generated_at: now()
        } -> inventory_report {
          key: category + "_" + product.sku
        }
      }
    }

    // Overall summary across all products
    store {
      total_products: length(products),
      report_generated: now()
    } -> inventory_report {
      key: "_summary"
    }

    // Flag out-of-stock products individually
    for product in products where .quantity == 0 {
      store {
        sku: product.sku,
        name: product.name,
        status: "out_of_stock",
        flagged_at: now()
      } -> inventory_report {
        key: "oos_" + product.sku
      }
    }
  }

  // ============================================================
  // ACTION: Export Customer Data
  // ============================================================

  action ExportCustomers {
    // Export one row per order, attributed to its customer.
    // (Per-customer aggregation would require a filtered collection, which
    //  is only expressible via a `for ... where` loop, not a `let` binding.)
    for order in orders {
      store {
        customer_id: order.customer_id,
        order_id: order.id,
        order_total: order.total,
        exported_at: now()
      } -> customer_export {
        key: order.customer_id + "_" + order.id
      }
    }

    // Export summary
    store {
      export_type: "customers",
      total_orders: length(orders),
      total_revenue: sum(orders.total),
      generated_at: now()
    } -> customer_export {
      key: "_metadata"
    }
  }

  // ============================================================
  // ACTION: Generate Daily Summary
  // ============================================================

  action GenerateDailySummary {
    let today = now()

    // Emit a row per order into the daily bucket. Status grouping and a
    // time-window filter over a collection would need a `for ... where`
    // loop rather than inline `where` expressions, so we record each order
    // individually and let downstream tooling group by status/date.
    for order in orders {
      store {
        date: today,
        order_id: order.id,
        status: order.status,
        total: order.total,
        recorded_at: now()
      } -> daily_summary {
        key: order.id
      }
    }

    // Top-level daily totals
    store {
      date: today,
      total_orders: length(orders),
      total_revenue: sum(orders.total),
      total_products: length(products),
      generated_at: now()
    } -> daily_summary {
      key: "_summary"
    }
  }

  // ============================================================
  // ACTION: Full Backup
  // ============================================================

  action CreateBackup {
    // Backup all data to file store
    store {
      backup_type: "full",
      timestamp: now(),
      data: {
        orders: orders,
        products: products
      },
      record_counts: {
        orders: length(orders),
        products: length(products)
      }
    } -> backup {
      key: "backup_" + now()
    }
  }

  // ============================================================
  // PIPELINE
  // ============================================================

  run FetchData
    then [ExportOrders, ExportCustomers, GenerateInventoryReport]  // Parallel exports
    then GenerateDailySummary
    then CreateBackup

  // ============================================================
  // SCHEDULE: Run daily at 2 AM
  // ============================================================

  schedule: cron "0 2 * * *"
}
